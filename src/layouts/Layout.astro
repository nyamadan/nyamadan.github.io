---
interface Props { title?: string; description?: string; }
const {
	title = 'nyamadan | Web & 3D Engineer',
	description = 'Webフロントエンドと3DCG技術を得意とするプログラマ、nyamadanのポートフォリオ。',
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const profileImageUrl = new URL('/profile.png', Astro.site);
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f4f1eb" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:site_name" content="nyamadan" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={profileImageUrl} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:site" content="@nyamadandan" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={profileImageUrl} />
		<title>{title}</title>
	</head>
	<body><slot /></body>
</html>

<style is:global>
	:root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #20201e; background: #f4f1eb; font-synthesis: none; }
	* { box-sizing: border-box; }
	html, body { margin: 0; min-width: 320px; min-height: 100%; scroll-behavior: smooth; }
	body { background: radial-gradient(circle at 82% 4%, rgb(183 119 63 / 10%), transparent 28rem), #f4f1eb; }
	a { color: inherit; }
	::selection { color: #fff; background: #9a5327; }
	:focus-visible { outline: 3px solid #b46532; outline-offset: 4px; }
</style>
