---
import profileImage from '../images/icon.png';
import Layout from '../layouts/Layout.astro';

const careers = [
	['2011 —', '独立系システムインテグレータ', 'Javaを用いたECサイト開発'],
	['2012 —', 'スマートフォンゲーム開発会社', '自社ゲームエンジンでのLua開発、JavaScriptを用いたWebViewゲーム開発'],
	['2019 —', 'ウェブサービス開発会社', 'Unityを用いたスマートフォンアプリ開発、Reactを用いたウェブサービス開発'],
];
const skills = [
	['Web Frontend', ['TypeScript', 'React', 'Sass', 'WebGL']],
	['Unity', ['uGUI', 'Unity IAP']],
] as const;
const links = [
	['GitHub', 'https://github.com/nyamadan', '@nyamadan'],
	['Qiita', 'https://qiita.com/nyamadandan', '@nyamadandan'],
	['X', 'https://x.com/nyamadandan', '@nyamadandan'],
];
---

<Layout>
	<header class="site-header">
		<a class="wordmark" href="#top" aria-label="ページ上部へ">NYMD<span>.</span></a>
		<nav aria-label="メインナビゲーション"><a href="#about">About</a><a href="#career">Career</a><a href="#contact">Links</a></nav>
	</header>
	<main id="top">
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow">Web & 3D Engineer</p>
				<h1 id="hero-title">技術を、<br /><em>人の幸せ</em>につなげる。</h1>
				<p class="lead">Webフロントエンドと3DCG技術が好きなプログラマです。<br />使う人の体験を考え、丁寧にものをつくります。</p>
				<a class="text-link" href="#about">プロフィールを見る <span aria-hidden="true">↓</span></a>
			</div>
			<div class="portrait-wrap">
				<div class="portrait-accent" aria-hidden="true"></div>
				<img src={profileImage.src} width="320" height="320" alt="nyamadanのプロフィール画像" />
				<p><span>Based in Japan</span><span>Since 2011</span></p>
			</div>
		</section>

		<section id="about" class="section" aria-labelledby="about-title">
			<div class="section-heading"><p class="index">01</p><h2 id="about-title">About</h2></div>
			<div class="about-body">
				<p class="statement">ITで人を幸せにする。</p>
				<div class="about-copy"><p>1986年生まれのプログラマ。2011年に大学院を修了後、Unityを用いたゲーム開発や、Reactを用いたウェブフロントエンド開発に従事してきました。</p><p>ウェブフロントエンドや3DCG技術を通じて、心地よく使える体験を届けることを大切にしています。</p></div>
			</div>
		</section>

		<section id="career" class="section" aria-labelledby="career-title">
			<div class="section-heading"><p class="index">02</p><h2 id="career-title">Career</h2></div>
			<ol class="timeline">{careers.map(([year, company, description]) => <li><p class="year">{year}</p><div><h3>{company}</h3><p>{description}</p></div></li>)}</ol>
		</section>

		<section class="section" aria-labelledby="skills-title">
			<div class="section-heading"><p class="index">03</p><h2 id="skills-title">Skills</h2></div>
			<div class="skills-grid">{skills.map(([category, items]) => <article><p class="skill-label">{category}</p><ul>{items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
		</section>

		<section id="contact" class="section" aria-labelledby="links-title">
			<div class="section-heading"><p class="index">04</p><h2 id="links-title">Find me online</h2></div>
			<ul class="link-list">{links.map(([label, href, detail]) => <li><a href={href} target="_blank" rel="noopener noreferrer"><span class="link-name">{label}</span><span class="link-detail">{detail}</span><span class="arrow" aria-hidden="true">↗</span></a></li>)}</ul>
		</section>
	</main>
	<footer><p>© {new Date().getFullYear()} nyamadan</p><a href="#top">Back to top ↑</a></footer>
</Layout>

<style>
	.site-header, main, footer { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }
	.site-header { display: flex; align-items: center; justify-content: space-between; padding-block: 32px; }
	.wordmark { font-size: 1.15rem; font-weight: 800; letter-spacing: .12em; text-decoration: none; }
	.wordmark span, .index, .hero em { color: #a55629; }
	nav { display: flex; gap: clamp(20px, 4vw, 48px); }
	nav a, footer a { font-size: .8rem; font-weight: 650; letter-spacing: .08em; text-decoration: none; }
	nav a:hover, footer a:hover, .text-link:hover { color: #a55629; }
	.hero { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(260px, .6fr); align-items: center; gap: clamp(48px, 8vw, 112px); min-height: calc(100vh - 96px); padding: 64px 0 112px; }
	.eyebrow, .skill-label, .year { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .76rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
	.eyebrow::before { display: inline-block; width: 38px; height: 1px; margin-right: 14px; vertical-align: middle; background: currentColor; content: ''; }
	h1 { max-width: 780px; margin: 28px 0; font-family: Georgia, "Yu Mincho", serif; font-size: clamp(3rem, 7.5vw, 6.7rem); font-weight: 500; line-height: 1.08; letter-spacing: -.055em; }
	h1 em { font-weight: inherit; }
	.lead { margin: 0 0 40px; color: #5d5b56; font-size: clamp(.95rem, 1.5vw, 1.08rem); line-height: 2; }
	.text-link { display: inline-flex; gap: 32px; align-items: center; padding-bottom: 8px; border-bottom: 1px solid; font-size: .84rem; font-weight: 700; letter-spacing: .06em; text-decoration: none; }
	.portrait-wrap { position: relative; justify-self: end; width: min(100%, 340px); }
	.portrait-wrap img { position: relative; display: block; width: 100%; height: auto; aspect-ratio: 1; border: 1px solid rgb(32 32 30 / 18%); border-radius: 50%; object-fit: cover; filter: saturate(.78) contrast(1.04); }
	.portrait-accent { position: absolute; inset: -18px 18px 18px -18px; border: 1px solid #b46532; border-radius: 50%; }
	.portrait-wrap > p { display: flex; justify-content: space-between; margin: 22px 0 0; color: #73706a; font: .66rem ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
	.section { display: grid; grid-template-columns: minmax(180px, .35fr) minmax(0, 1fr); gap: clamp(40px, 8vw, 120px); padding: clamp(80px, 11vw, 144px) 0; border-top: 1px solid rgb(32 32 30 / 22%); }
	.section-heading .index { margin: 0 0 16px; }
	h2 { margin: 0; font: 500 clamp(2rem, 4vw, 3.5rem) Georgia, serif; letter-spacing: -.04em; }
	.about-body { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(32px, 6vw, 80px); }
	.statement { margin: 0; font: clamp(1.65rem, 3vw, 2.7rem)/1.5 Georgia, "Yu Mincho", serif; }
	.about-copy p, .timeline p { margin: 0; color: #5d5b56; line-height: 1.9; }
	.about-copy p + p { margin-top: 20px; }
	.timeline, .link-list, .skills-grid ul { padding: 0; margin: 0; list-style: none; }
	.timeline li { display: grid; grid-template-columns: 110px 1fr; gap: 24px; padding: 0 0 44px; }
	.timeline li + li { padding-top: 44px; border-top: 1px solid rgb(32 32 30 / 12%); }
	.timeline h3 { margin: 0 0 12px; font-size: 1.1rem; font-weight: 650; }
	.year { color: #a55629 !important; }
	.skills-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
	.skills-grid article { min-height: 240px; padding: 32px; border: 1px solid rgb(32 32 30 / 18%); background: rgb(255 255 255 / 22%); }
	.skill-label { margin: 0 0 46px; color: #a55629; }
	.skills-grid li { font: clamp(1.4rem, 2.5vw, 2rem)/1.5 Georgia, serif; }
	.link-list li { border-bottom: 1px solid rgb(32 32 30 / 18%); }
	.link-list li:first-child { border-top: 1px solid rgb(32 32 30 / 18%); }
	.link-list a { display: grid; grid-template-columns: 1fr 1fr auto; align-items: center; padding: 28px 8px; text-decoration: none; transition: padding 160ms ease, color 160ms ease; }
	.link-list a:hover { padding-inline: 16px; color: #a55629; }
	.link-name { font: 1.8rem Georgia, serif; }
	.link-detail { color: #73706a; font: .76rem ui-monospace, monospace; }
	.arrow { font-size: 1.3rem; }
	footer { display: flex; justify-content: space-between; padding: 32px 0 48px; border-top: 1px solid rgb(32 32 30 / 22%); font-size: .75rem; letter-spacing: .08em; }
	footer p { margin: 0; }
	@media (max-width: 760px) {
		.site-header, main, footer { width: min(100% - 32px, 1160px); }
		.site-header { padding-block: 24px; } nav { gap: 16px; } nav a { font-size: .68rem; }
		.hero { grid-template-columns: 1fr; min-height: auto; padding: 72px 0 88px; }
		.hero-copy { display: contents; } h1 { order: 1; margin: 12px 0 16px; } .eyebrow { order: 0; } .lead { order: 3; } .text-link { order: 4; justify-self: start; }
		.portrait-wrap { order: 2; justify-self: center; width: min(72vw, 300px); margin: 28px 0 16px; }
		.section { grid-template-columns: 1fr; gap: 48px; }
		.section-heading { display: flex; gap: 20px; align-items: baseline; }
		.about-body, .skills-grid { grid-template-columns: 1fr; }
		.timeline li { grid-template-columns: 80px 1fr; gap: 12px; }
		.link-list a { grid-template-columns: 1fr auto; } .link-detail { display: none; }
	}
	@media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } .link-list a { transition: none; } }
</style>
