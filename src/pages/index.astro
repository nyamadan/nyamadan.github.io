---
import profileImage from '../images/icon.png';
import Layout from '../layouts/Layout.astro';

const careers = [
	['2011 —', '独立系システムインテグレータ', 'Javaを用いたECサイト開発'],
	['2012 —', 'スマートフォンゲーム開発会社', '自社ゲームエンジンでのLua開発、JavaScriptを用いたWebViewゲーム開発'],
	['2019 —', 'ウェブサービス開発会社', 'Unityを用いたスマートフォンアプリ開発、Reactを用いたウェブサービス開発'],
];
const skills = [
	['Web Frontend', ['TypeScript', 'React', 'Sass', 'WebGL']],
	['Unity', ['uGUI', 'Unity IAP']],
] as const;
const links = [
	['GitHub', 'https://github.com/nyamadan', '@nyamadan'],
	['Qiita', 'https://qiita.com/nyamadandan', '@nyamadandan'],
	['X', 'https://x.com/nyamadandan', '@nyamadandan'],
];
---

<Layout>
	<header class="mx-auto flex w-[min(1160px,calc(100%-48px))] items-center justify-between py-8 max-[760px]:w-[min(calc(100%-32px),1160px)] max-[760px]:py-6">
		<a class="text-[1.15rem] font-extrabold tracking-[.12em] no-underline" href="#top" aria-label="ページ上部へ">nyamadan<span class="text-[#a55629]">.</span></a>
		<nav class="flex gap-[clamp(20px,4vw,48px)] max-[760px]:gap-4" aria-label="メインナビゲーション"><a class="text-[.8rem] font-[650] tracking-[.08em] no-underline hover:text-[#a55629] max-[760px]:text-[.68rem]" href="#about">About</a><a class="text-[.8rem] font-[650] tracking-[.08em] no-underline hover:text-[#a55629] max-[760px]:text-[.68rem]" href="#career">Career</a><a class="text-[.8rem] font-[650] tracking-[.08em] no-underline hover:text-[#a55629] max-[760px]:text-[.68rem]" href="#contact">Links</a></nav>
	</header>
	<main id="top" class="mx-auto w-[min(1160px,calc(100%-48px))] max-[760px]:w-[min(calc(100%-32px),1160px)]">
		<section class="grid min-h-[calc(100vh-96px)] grid-cols-[minmax(0,1.4fr)_minmax(260px,.6fr)] items-center gap-[clamp(48px,8vw,112px)] py-16 pb-28 max-[760px]:min-h-auto max-[760px]:grid-cols-1 max-[760px]:py-[72px] max-[760px]:pb-[88px]" aria-labelledby="hero-title">
			<div class="max-[760px]:contents">
				<p class="font-mono text-[.76rem] font-bold tracking-[.16em] uppercase before:mr-3.5 before:inline-block before:h-px before:w-[38px] before:bg-current before:align-middle before:content-[''] max-[760px]:order-0">Web & 3D Engineer</p>
				<h1 id="hero-title" class="my-7 max-w-[780px] font-serif text-[clamp(3rem,7.5vw,6.7rem)] leading-[1.08] font-medium tracking-[-.055em] max-[760px]:order-1 max-[760px]:my-3 max-[760px]:mb-4">技術を、<br /><em class="font-inherit text-[#a55629]">人の幸せ</em>につなげる。</h1>
				<p class="mb-10 text-[clamp(.95rem,1.5vw,1.08rem)] leading-8 text-[#5d5b56] max-[760px]:order-3">Webフロントエンドと3DCG技術が好きなプログラマです。<br />使う人の体験を考え、丁寧にものをつくります。</p>
				<a class="inline-flex items-center gap-8 border-b pb-2 text-[.84rem] font-bold tracking-[.06em] no-underline hover:text-[#a55629] max-[760px]:order-4 max-[760px]:justify-self-start" href="#about">プロフィールを見る <span aria-hidden="true">↓</span></a>
			</div>
			<div class="relative w-[min(100%,340px)] justify-self-end max-[760px]:order-2 max-[760px]:my-7 max-[760px]:mb-4 max-[760px]:w-[min(72vw,300px)] max-[760px]:justify-self-center">
				<div class="absolute -top-[18px] right-[18px] bottom-[18px] -left-[18px] rounded-full border border-[#b46532]" aria-hidden="true"></div>
				<img class="relative block aspect-square h-auto w-full rounded-full border border-[rgb(32_32_30_/_18%)] object-cover [filter:saturate(.78)_contrast(1.04)]" src={profileImage.src} width="320" height="320" alt="nyamadanのプロフィール画像" />
				<p class="mt-[22px] flex justify-between font-mono text-[.66rem] tracking-[.08em] text-[#73706a] uppercase"><span>Based in Japan</span><span>Since 2011</span></p>
			</div>
		</section>

		<section id="about" class="grid grid-cols-[minmax(180px,.35fr)_minmax(0,1fr)] gap-[clamp(40px,8vw,120px)] border-t border-[rgb(32_32_30_/_22%)] py-[clamp(80px,11vw,144px)] max-[760px]:grid-cols-1 max-[760px]:gap-12" aria-labelledby="about-title">
			<div class="max-[760px]:flex max-[760px]:items-baseline max-[760px]:gap-5"><p class="mb-4 font-mono text-[.76rem] font-bold tracking-[.16em] text-[#a55629] uppercase">01</p><h2 id="about-title" class="m-0 font-serif text-[clamp(2rem,4vw,3.5rem)] leading-normal font-medium tracking-[-.04em]">About</h2></div>
			<div class="grid grid-cols-[.8fr_1.2fr] gap-[clamp(32px,6vw,80px)] max-[760px]:grid-cols-1">
				<p class="m-0 font-serif text-[clamp(1.65rem,3vw,2.7rem)] leading-normal">ITで人を幸せにする。</p>
				<div><p class="m-0 leading-[1.9] text-[#5d5b56]">1986年生まれのプログラマ。2011年に大学院を修了後、Unityを用いたゲーム開発や、Reactを用いたウェブフロントエンド開発に従事してきました。</p><p class="mt-5 leading-[1.9] text-[#5d5b56]">ウェブフロントエンドや3DCG技術を通じて、心地よく使える体験を届けることを大切にしています。</p></div>
			</div>
		</section>

		<section id="career" class="grid grid-cols-[minmax(180px,.35fr)_minmax(0,1fr)] gap-[clamp(40px,8vw,120px)] border-t border-[rgb(32_32_30_/_22%)] py-[clamp(80px,11vw,144px)] max-[760px]:grid-cols-1 max-[760px]:gap-12" aria-labelledby="career-title">
			<div class="max-[760px]:flex max-[760px]:items-baseline max-[760px]:gap-5"><p class="mb-4 font-mono text-[.76rem] font-bold tracking-[.16em] text-[#a55629] uppercase">02</p><h2 id="career-title" class="m-0 font-serif text-[clamp(2rem,4vw,3.5rem)] leading-normal font-medium tracking-[-.04em]">Career</h2></div>
			<ol class="m-0 list-none p-0">{careers.map(([year, company, description], index) => <li class:list={['grid grid-cols-[110px_1fr] gap-6 pb-11 max-[760px]:grid-cols-[80px_1fr] max-[760px]:gap-3', { 'border-t border-[rgb(32_32_30_/_12%)] pt-11': index > 0 }]}><p class="m-0 font-mono text-[.76rem] font-bold tracking-[.16em] text-[#a55629] uppercase">{year}</p><div><h3 class="mb-3 text-[1.1rem] font-[650]">{company}</h3><p class="m-0 leading-[1.9] text-[#5d5b56]">{description}</p></div></li>)}</ol>
		</section>

		<section class="grid grid-cols-[minmax(180px,.35fr)_minmax(0,1fr)] gap-[clamp(40px,8vw,120px)] border-t border-[rgb(32_32_30_/_22%)] py-[clamp(80px,11vw,144px)] max-[760px]:grid-cols-1 max-[760px]:gap-12" aria-labelledby="skills-title">
			<div class="max-[760px]:flex max-[760px]:items-baseline max-[760px]:gap-5"><p class="mb-4 font-mono text-[.76rem] font-bold tracking-[.16em] text-[#a55629] uppercase">03</p><h2 id="skills-title" class="m-0 font-serif text-[clamp(2rem,4vw,3.5rem)] leading-normal font-medium tracking-[-.04em]">Skills</h2></div>
			<div class="grid grid-cols-2 gap-5 max-[760px]:grid-cols-1">{skills.map(([category, items]) => <article class="min-h-60 border border-[rgb(32_32_30_/_18%)] bg-[rgb(255_255_255_/_22%)] p-8"><p class="mb-[46px] font-mono text-[.76rem] font-bold tracking-[.16em] text-[#a55629] uppercase">{category}</p><ul class="m-0 list-none p-0">{items.map((item) => <li class="font-serif text-[clamp(1.4rem,2.5vw,2rem)] leading-normal">{item}</li>)}</ul></article>)}</div>
		</section>

		<section id="contact" class="grid grid-cols-[minmax(180px,.35fr)_minmax(0,1fr)] gap-[clamp(40px,8vw,120px)] border-t border-[rgb(32_32_30_/_22%)] py-[clamp(80px,11vw,144px)] max-[760px]:grid-cols-1 max-[760px]:gap-12" aria-labelledby="links-title">
			<div class="max-[760px]:flex max-[760px]:items-baseline max-[760px]:gap-5"><p class="mb-4 font-mono text-[.76rem] font-bold tracking-[.16em] text-[#a55629] uppercase">04</p><h2 id="links-title" class="m-0 font-serif text-[clamp(2rem,4vw,3.5rem)] leading-normal font-medium tracking-[-.04em]">Find me online</h2></div>
			<ul class="m-0 list-none p-0">{links.map(([label, href, detail], index) => <li class:list={['border-b border-[rgb(32_32_30_/_18%)]', { 'border-t': index === 0 }]}><a class="grid grid-cols-[1fr_1fr_auto] items-center px-2 py-7 no-underline transition-[padding,color] duration-160 hover:px-4 hover:text-[#a55629] motion-reduce:transition-none max-[760px]:grid-cols-[1fr_auto]" href={href} target="_blank" rel="noopener noreferrer"><span class="font-serif text-[1.8rem]">{label}</span><span class="font-mono text-[.76rem] text-[#73706a] max-[760px]:hidden">{detail}</span><span class="text-[1.3rem]" aria-hidden="true">↗</span></a></li>)}</ul>
		</section>
	</main>
	<footer class="mx-auto flex w-[min(1160px,calc(100%-48px))] justify-between border-t border-[rgb(32_32_30_/_22%)] pt-8 pb-12 text-xs tracking-[.08em] max-[760px]:w-[min(calc(100%-32px),1160px)]"><p class="m-0">© {new Date().getFullYear()} nyamadan</p><a class="text-[.8rem] font-[650] tracking-[.08em] no-underline hover:text-[#a55629]" href="#top">Back to top ↑</a></footer>
</Layout>
