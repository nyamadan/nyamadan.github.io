{
  "name": "nyamadan.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "UNLICENSED",
  "author": "Yoshiki YAMADA",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "dev": "astro dev --background --host 0.0.0.0",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "7.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "tailwindcss": "4.3.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,astro}": [
      "pnpm run fmt --no-error-on-unmatched-pattern",
      "pnpm run lint"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.23.0"
}
